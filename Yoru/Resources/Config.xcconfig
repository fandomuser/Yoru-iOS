// Yoru — Build Configuration
// Official Telegram API client configuration
// Obtain your credentials at https://my.telegram.org

// Telegram API Client Credentials (Override with your developer credentials)
YORU_TELEGRAM_API_ID = 12345678
YORU_TELEGRAM_API_HASH = "0123456789abcdef0123456789abcdef"

// Product Identity
PRODUCT_BUNDLE_IDENTIFIER = com.yoru.client
PRODUCT_NAME = Yoru
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Target Platform
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
